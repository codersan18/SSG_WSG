# Copy the values you need into .env. This file holds no secrets.

# ---- Required
SSG_BASE_URL=https://api.ssg-wsg.sg          # production. Sandbox: https://mock-api.ssg-wsg.sg
SSG_CERT_PATH=./certsnew/cert.pem
SSG_KEY_PATH=./certsnew/key.pem
SSG_ENCRYPTION_KEY=                          # Base64, from Developer Portal > Subscription > Encryption Key
SSG_UEN=
SSG_TP_CODE=

# ---- Optional
PORT=3000
SSG_PASSPHRASE=                              # only if your private key is password-protected
SSG_TIMEOUT_MS=30000
GATEWAY_API_KEY=                             # set this in production: callers must send it as the x-api-key header
TEST_RUN_ID=                                 # used by "npm run check"

# ---- x-api-version per API (leave blank to use the defaults in config/tpgEndpoints.js)
SSG_COURSE_SEARCH_VERSION=
SSG_COURSE_DETAILS_VERSION=
SSG_ADD_COURSE_RUN_VERSION=
SSG_EDIT_COURSE_RUN_VERSION=
SSG_GET_COURSE_RUN_VERSION=
SSG_COURSE_SESSIONS_VERSION=
SSG_ATTENDANCE_VERSION=
SSG_TRAINER_VERSION=
SSG_ENROLMENT_VERSION=
SSG_ASSESSMENT_VERSION=
SSG_GRANTS_VERSION=
SSG_GRANT_CALCULATOR_VERSION=
SSG_SFC_VERSION=
